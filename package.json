{
  "name": "minh-khue-agent-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "check:skills": "node scripts/check-skills.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint scripts pilot tests playwright.config.mjs eslint.config.mjs",
    "test": "node --experimental-sqlite --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "pilot": "node --experimental-sqlite pilot/serve.mjs",
    "check": "npm run check:skills && npm run check:docs && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "css-select": "7.0.0",
    "css-tree": "3.2.1",
    "domutils": "4.0.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "htmlparser2": "12.0.0"
  }
}
