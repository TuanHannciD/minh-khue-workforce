PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Required; set only for a verified task-owned database.
DATABASE_URL=
# Required configuration secret, at least 32 UTF-8 bytes; never commit its value.
AUTH_THROTTLE_SECRET=
# Production also requires exact HTTPS WEB_ORIGIN and approved TLS termination.
TLS_TERMINATED=false
