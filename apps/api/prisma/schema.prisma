generator client {
  provider = "prisma-client"
  output = "../src/infrastructure/db/generated"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @db.Uuid
  username String @unique @db.VarChar(64)
  passwordHash String
  authVersion BigInt @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
}

model Session {
  id String @id @db.Uuid
  tokenHash Bytes @unique
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  authVersion BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  bucketKey Bytes
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
  expiresAt DateTime @db.Timestamptz(3)
  @@id([bucketKey, windowStart])
  @@index([expiresAt])
}

model Employee {
  id String @id @db.Uuid
  name String
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  revision String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  cells AttendanceCell[]
}

enum AttendanceKind {
  work
  overtime
}

enum CellValueType {
  empty
  number
  absence
}

model AttendanceCell {
  employeeId String @db.Uuid
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  kind AttendanceKind
  valueType CellValueType
  halfUnits Int? @db.SmallInt
  reminder Boolean @default(false)
  revision String @db.Uuid
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([employeeId, date, kind])
  @@index([date, employeeId])
}
