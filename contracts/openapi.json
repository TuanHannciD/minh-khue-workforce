{
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "additionalProperties": false,
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetailDto" },
          "requestId": { "format": "uuid", "type": "string" }
        },
        "required": ["error", "requestId"],
        "type": "object"
      },
      "ErrorDetailDto": {
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"],
        "type": "object"
      },
      "HealthDto": {
        "additionalProperties": false,
        "properties": { "status": { "enum": ["ok"], "type": "string" } },
        "required": ["status"],
        "type": "object"
      },
      "LoginDto": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Maximum 1024 UTF-8 bytes; never trimmed",
            "format": "password",
            "maxLength": 1024,
            "type": "string",
            "writeOnly": true
          },
          "username": { "maxLength": 64, "minLength": 1, "type": "string" }
        },
        "required": ["username", "password"],
        "type": "object"
      },
      "LogoutDto": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "SessionDto": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": { "format": "date-time", "type": "string" },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "user": { "$ref": "#/components/schemas/SessionIdentityDto" }
        },
        "required": ["user", "expiresAt", "idleExpiresAt"],
        "type": "object"
      },
      "SessionIdentityDto": {
        "additionalProperties": false,
        "properties": {
          "userId": { "format": "uuid", "type": "string" },
          "username": { "type": "string" }
        },
        "required": ["userId", "username"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": { "in": "cookie", "name": "mkw_session", "type": "apiKey" }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Minh Khuê bootstrap API",
    "version": "0.0.0"
  },
  "openapi": "3.0.3",
