{
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "additionalProperties": false,
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetailDto" },
          "requestId": { "format": "uuid", "type": "string" }
        },
        "required": ["error", "requestId"],
        "type": "object"
      },
      "CreateEmployeeDto": {
        "additionalProperties": false,
        "properties": {
          "endDate": {
            "description": "Omission defaults to null; null means no end date",
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "name": {
            "description": "Trimmed, 1–200 Unicode code points",
            "type": "string"
          },
          "startDate": { "format": "date", "type": "string" }
        },
        "required": ["name", "startDate"],
        "type": "object"
      },
      "EmployeeDto": {
        "additionalProperties": false,
        "properties": {
          "endDate": { "format": "date", "nullable": true, "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "name": { "type": "string" },
          "revision": { "type": "string" },
          "startDate": { "format": "date", "type": "string" }
        },
        "required": ["id", "name", "startDate", "endDate", "revision"],
        "type": "object"
      },
      "EmploymentApiErrorDto": {
        "additionalProperties": false,
        "properties": {
          "error": { "$ref": "#/components/schemas/EmploymentErrorDto" },
          "requestId": { "format": "uuid", "type": "string" }
        },
        "required": ["error", "requestId"],
        "type": "object"
      },
      "EmploymentCellKeyDto": {
        "additionalProperties": false,
        "properties": {
          "date": { "format": "date", "type": "string" },
          "employeeId": { "format": "uuid", "type": "string" },
          "kind": { "enum": ["work", "overtime"], "type": "string" }
        },
        "required": ["employeeId", "date", "kind"],
        "type": "object"
      },
      "EmploymentErrorDetailsDto": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": { "$ref": "#/components/schemas/EmploymentCellKeyDto" },
            "type": "array"
          },
          "current": { "$ref": "#/components/schemas/EmployeeDto" },
          "fields": {
            "items": { "$ref": "#/components/schemas/EmploymentFieldErrorDto" },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EmploymentErrorDto": {
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "details": {
            "$ref": "#/components/schemas/EmploymentErrorDetailsDto"
          },
          "message": { "type": "string" }
        },
        "required": ["code", "message"],
        "type": "object"
      },
      "EmploymentFieldErrorDto": {
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        },
        "required": ["path", "code", "message"],
        "type": "object"
      },
      "ErrorDetailDto": {
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"],
        "type": "object"
      },
      "HealthDto": {
        "additionalProperties": false,
        "properties": { "status": { "enum": ["ok"], "type": "string" } },
        "required": ["status"],
        "type": "object"
      },
      "LoginDto": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Maximum 1024 UTF-8 bytes; never trimmed",
            "format": "password",
            "maxLength": 1024,
            "type": "string",
            "writeOnly": true
          },
          "username": { "maxLength": 64, "minLength": 1, "type": "string" }
        },
        "required": ["username", "password"],
        "type": "object"
      },
      "LogoutDto": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "SessionDto": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": { "format": "date-time", "type": "string" },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "user": { "$ref": "#/components/schemas/SessionIdentityDto" }
        },
        "required": ["user", "expiresAt", "idleExpiresAt"],
        "type": "object"
      },
      "SessionIdentityDto": {
        "additionalProperties": false,
        "properties": {
          "userId": { "format": "uuid", "type": "string" },
          "username": { "type": "string" }
        },
        "required": ["userId", "username"],
        "type": "object"
      },
      "UpdateEmploymentDto": {
        "additionalProperties": false,
        "minProperties": 2,
        "properties": {
          "endDate": { "format": "date", "nullable": true, "type": "string" },
          "expectedRevision": {
            "description": "Opaque baseline revision",
            "type": "string"
          },
          "name": { "type": "string" },
          "startDate": { "format": "date", "type": "string" }
        },
        "required": ["expectedRevision"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": { "in": "cookie", "name": "mkw_session", "type": "apiKey" }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Minh Khuê bootstrap API",
    "version": "0.0.0"
  },
  "openapi": "3.0.3",
